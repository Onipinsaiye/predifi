# PrediFi testnet smoke test — copy to .env.smoke and fill in values
# NEVER commit .env.smoke (it contains private key identities)
#
# Generate a fresh funded identity (recommended — isolates smoke traffic):
#   stellar keys generate smoke-creator --network testnet
#   curl "https://friendbot.stellar.org?addr=$(stellar keys address smoke-creator)"
#
# For a two-account test (creator + participant):
#   stellar keys generate smoke-participant --network testnet
#   curl "https://friendbot.stellar.org?addr=$(stellar keys address smoke-participant)"

# Deployed PrediFi contract ID (from deployed_contracts_testnet.json)
PREDIFI_ID=

# Deployed AccessControl contract ID
AC_ID=

# Token contract to use for staking — default is the testnet XLM SAC
TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2QLGM5A

# Stellar CLI identity name for the creator / admin signer
SOURCE=smoke-creator

# Optional: separate identity for the participant role
# If omitted, SOURCE is reused
# PARTICIPANT=smoke-participant

# Network (testnet | futurenet | mainnet)
NETWORK=testnet
