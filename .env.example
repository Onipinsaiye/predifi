# PrediFi Local Full-Stack Development Environment
#
# Copy this file to `.env` in the repository root to customize local defaults:
#   cp .env.example .env
#
# Docker Compose will automatically read this file when running `docker compose up`.

# ── Application Environment ───────────────────────────────────────────────────
PREDIFI_APP_ENV=development
RUST_LOG=info

# ── Service Port Mappings (Host Ports) ─────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
STELLAR_PORT=8000

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=predifi
PREDIFI_DATABASE_URL=postgres://postgres:postgres@postgres:5432/predifi

# ── Redis Cache & Rate Limiting ───────────────────────────────────────────────
PREDIFI_REDIS_URL=redis://redis:6379

# ── Stellar & Soroban RPC ─────────────────────────────────────────────────────
# Default: Local standalone Stellar container (stellar/quickstart)
PREDIFI_STELLAR_RPC_URL=http://stellar:8000/rpc
# To use public Stellar Testnet instead of running the local container:
# PREDIFI_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ── Frontend Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# ── CORS & Security ───────────────────────────────────────────────────────────
PREDIFI_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
PREDIFI_SECRET_KEY=predifi-dev-secret-do-not-use-in-production-32

# ── Database Seeder Configuration ─────────────────────────────────────────────
# Number of sample prediction pools to seed on initial run
SEED_NUM_POOLS=10
